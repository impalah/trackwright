# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 120

# The Cubase MIDI Remote script (ES5) and the Node test harness are indented with tabs.
[*.js]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break; list continuations use 2 or 3 spaces.
trim_trailing_whitespace = false
indent_size = unset
max_line_length = off

[*.toml]
indent_size = 4

[*.sh]
indent_size = 4

# Verbatim texts: do not reformat.
[{LICENSE,docs/reference/**,uv.lock}]
trim_trailing_whitespace = false
insert_final_newline = unset
indent_style = unset
indent_size = unset
